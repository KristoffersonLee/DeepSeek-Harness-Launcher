# v5.0.0: uninstall.cmd is the target of the registry UninstallString and must be CRLF
# (cmd.exe has known problems with LF-only files around labels, goto and parenthesised
# blocks). Keep batch files CRLF; everything else per platform default.
*.cmd text eol=crlf
*.ps1 text eol=lf
*.rs  text eol=lf
